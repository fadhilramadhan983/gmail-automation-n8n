        "jsCode": "const j = $json;\nreturn {\n  json: {\n    email_id: j.email_id,\n    tanggal: j.tanggal_email,\n    pengirim: j.pengirim,\n    subjek: j.subjek,\n    sumber: j.sumber,\n    kategori: j.kategori || '',\n    perusahaan: j.perusahaan || '',\n    posisi: j.posisi || '',\n    ringkasan: j.ringkasan || '',\n    deadline: j.deadline || '',\n    jadwal: j.jadwal || '',\n    perlu_diperiksa: j.perlu_diperiksa ? 'ya' : 'tidak',\n    hasil_luna: j.hasil_luna || '',\n    hasil_gemini: '',\n    benar_salah: '',\n    status_notifikasi: '',\n  },\n};"
      },
